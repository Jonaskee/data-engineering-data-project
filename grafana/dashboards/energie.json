{
  "title": "Energie Dashboard",
  "uid": "energie-overzicht",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5m",
  "time": { "from": "now-90d", "to": "now" },
  "timezone": "browser",
  "tags": ["energie", "data-eng"],
  "panels": [
    {
      "id": 1,
      "title": "Elektriciteitsverbruik (Elia) — MW",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "postgres", "uid": "energie_postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "color": { "mode": "fixed", "fixedColor": "#5794F2" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "energie_postgres" },
          "rawSql": "SELECT tijd AS time, elia_total_load_mw * 1000000 AS \"Verbruik (W)\" FROM consumptie WHERE $__timeFilter(tijd) ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Productie per bron — MW",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "postgres", "uid": "energie_postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Elia Zon (W)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Vlaanderen Zon (W)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FADE2A" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Elia Wind (W)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Vlaanderen Wind (W)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#37872D" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "energie_postgres" },
          "rawSql": "SELECT tijd AS time, elia_zon_mw * 1000000 AS \"Elia Zon (W)\", vlaanderen_zon_mw * 1000000 AS \"Vlaanderen Zon (W)\", elia_wind_mw * 1000000 AS \"Elia Wind (W)\", vlaanderen_wind_mw * 1000000 AS \"Vlaanderen Wind (W)\" FROM productie WHERE $__timeFilter(tijd) ORDER BY 1",
          "format": "time_series",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Zonnestraling Antwerpen — W/m²",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "energie_postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "wm2",
          "custom": { "lineWidth": 1, "fillOpacity": 20 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Globaal (W/m²)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Direct (W/m²)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FADE2A" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Diffuus (W/m²)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#E0B400" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "energie_postgres" },
          "rawSql": "SELECT tijdstip AS time, ecmwf_radiation_wm2 AS \"Globaal (W/m²)\", ecmwf_direct_wm2 AS \"Direct (W/m²)\", ecmwf_diffuse_wm2 AS \"Diffuus (W/m²)\" FROM zon WHERE $__timeFilter(tijdstip) ORDER BY 1",
          "format": "time_series",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Windsnelheid — km/h",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "energie_postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "energie_postgres" },
          "rawSql": "SELECT tijdstip AS time, wind_ecmwf_2026_kmh AS \"ECMWF 2026 (km/h)\", wind_kmi_2002_kmh AS \"KMI 2002 (km/h)\", wind_ukkel_2024_kmh AS \"Ukkel 2024 (km/h)\", wind_antwerpen_archive_kmh AS \"Antwerpen Archief (km/h)\" FROM wind WHERE $__timeFilter(tijdstip) ORDER BY 1",
          "format": "time_series",
          "refId": "D",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Totale productie vs verbruik — MW",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "datasource": { "type": "postgres", "uid": "energie_postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Verbruik (W)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2495C" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Totale Productie (W)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "energie_postgres" },
          "rawSql": "SELECT c.tijd AS time, c.elia_total_load_mw * 1000000 AS \"Verbruik (W)\", (p.elia_zon_mw + p.elia_wind_mw + COALESCE(p.vlaanderen_zon_mw, 0) + COALESCE(p.vlaanderen_wind_mw, 0)) * 1000000 AS \"Totale Productie (W)\" FROM consumptie c JOIN productie p ON DATE_TRUNC('hour', c.tijd AT TIME ZONE 'UTC') = DATE_TRUNC('hour', p.tijd AT TIME ZONE 'UTC') WHERE $__timeFilter(c.tijd) ORDER BY 1",
          "format": "time_series",
          "refId": "E"
        }
      ]
    },
    {
      "id": 6,
      "title": "Database Tabel Metadata",
      "type": "table",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 8 },
      "datasource": { "type": "postgres", "uid": "energie_postgres" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "energie_postgres" },
          "rawSql": "SELECT table_name AS \"Tabel\", row_count AS \"Aantal Rijen\", column_count AS \"Aantal Kolommen\", columns AS \"Kolommen\" FROM table_metadata ORDER BY table_name",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "beste moment om energie te kopen (hoge productie + lage consumptie = beste moment) koopzone (groen)",
      "description": "Netto-vraag = Consumptie − Totale Productie (zon + wind). Lage waarden = hoge productie + lage consumptie = beste moment om energie te kopen. Drempel 7.500 MW = koopzone (groen).",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 10 },
      "datasource": { "type": "postgres", "uid": "energie_postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity"
          },
          "color": { "mode": "fixed", "fixedColor": "#73BF69" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 8000000000 },
              { "color": "red", "value": 9000000000 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Netto-vraag (W)" },
            "properties": [
              { "id": "custom.thresholdsStyle", "value": { "mode": "area" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "energie_postgres" },
          "rawSql": "SELECT tijd AS time, netto_vraag_mw * 1000000 AS \"Netto-vraag (W)\" FROM v_productie_consumptie WHERE $__timeFilter(tijd) ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Koop-score tabel Top 24 uur (laagste netto-vraag)",
      "description": "Historisch beste inkoopuren. Koop-score = 100 - (netto_vraag / max_netto_vraag * 100). Hogere score = beter koopmoment.",
      "type": "table",
      "gridPos": { "x": 0, "y": 50, "w": 24, "h": 8 },
      "datasource": { "type": "postgres", "uid": "energie_postgres" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Gem. Productie (MW)" },
            "properties": [{ "id": "unit", "value": "watt" }, { "id": "decimals", "value": 0 }, { "id": "custom.displayMode", "value": "color-background" }, { "id": "color", "value": { "mode": "continuous-GrYlRd" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Gem. Consumptie (MW)" },
            "properties": [{ "id": "unit", "value": "watt" }, { "id": "decimals", "value": 0 }]
          },
          {
            "matcher": { "id": "byName", "options": "Gem. Netto-vraag (MW)" },
            "properties": [{ "id": "unit", "value": "watt" }, { "id": "decimals", "value": 0 }, { "id": "custom.displayMode", "value": "color-background" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 8000000000 }, { "color": "red", "value": 9000000000 }] } }]
          },
          {
            "matcher": { "id": "byName", "options": "Koop-score (%)" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "custom.displayMode", "value": "lcd-gauge" },
              { "id": "color", "value": { "mode": "continuous-GrYlRd" } },
              { "id": "mappings", "value": [] },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.2 }, { "color": "green", "value": 0.4 }] } }
            ]
          }
        ]
      },
      "options": { "footer": { "show": false }, "sortBy": [{ "displayName": "Koop-score (%)", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "energie_postgres" },
          "rawSql": "SELECT EXTRACT(HOUR FROM tijd)::int AS \"Uur (UTC)\", ROUND(AVG(consumptie_mw) * 1000000) AS \"Gem. Consumptie (MW)\", ROUND(AVG(totale_productie_mw) * 1000000) AS \"Gem. Productie (MW)\", ROUND(AVG(netto_vraag_mw) * 1000000) AS \"Gem. Netto-vraag (MW)\", ROUND(CORR(consumptie_mw, totale_productie_mw)::numeric, 3) AS \"Correlatie r\", AVG(totale_productie_mw / NULLIF(consumptie_mw, 0)) AS \"Koop-score (%)\" FROM v_productie_consumptie GROUP BY 1 ORDER BY \"Koop-score (%)\" DESC",
          "format": "table",
          "refId": "A",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 13,
      "title": "Beste bestelmoment gedurende de dag: Hoe hoger hoe beter",
      "description": "Wanneer je in de dag je energie moet kopen hoe hoger hoe beter",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 58, "w": 24, "h": 10 },
      "datasource": { "type": "postgres", "uid": "energie_postgres" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 10,
            "showPoints": "always"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Koop-score" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } },
              { "id": "custom.fillOpacity", "value": 20 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Correlatie" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "energie_postgres" },
          "rawSql": "SELECT make_timestamp(2024, 1, 1, uur, 0, 0) as time, r AS \"Correlatie\", ratio AS \"Koop-score\" FROM (SELECT EXTRACT(HOUR FROM tijd)::int as uur, CORR(consumptie_mw, totale_productie_mw) as r, AVG(totale_productie_mw / NULLIF(consumptie_mw, 0)) as ratio FROM v_productie_consumptie GROUP BY 1) s ORDER BY uur",
          "format": "time_series",
          "refId": "A",
          "rawQuery": true
        }
      ]
    }
  ]
}
